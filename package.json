{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "description": "Hospital Management System backend using Koa, MongoDB, JWT, and role-based access",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon --watch . --ext ts --exec ts-node --transpile-only app.ts",
    "build": "tsc -p tsconfig.json",
    "seed:dev": "NODE_ENV=development node -r ts-node/register/transpile-only scripts/seed/seed.js",
    "migrate:patient-history": "node -r ts-node/register/transpile-only scripts/migrate-patient-history.js",
    "test": "node -e \"console.log('Test placeholder passed')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.3.0",
    "koa-compress": "^5.2.2",
    "koa-json": "^2.0.2",
    "koa-multer": "^1.0.2",
    "koa-router": "^12.0.0",
    "koa2-cors": "^2.0.6",
    "mongoose": "^7.8.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
